{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cki-demo/schemas/profile-public.schema.json",
  "title": "CKI profile — deployed public file",
  "description": "The submission keys plus the administrative key (consent_date, added by JO) and the derived key (base_location, added by the build). This is what a profile in the private repository is validated against before it is copied into the site build.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "career_stage", "country", "es_topics", "contact_visibility", "consent_date", "base_location"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "career_stage": { "type": "string", "minLength": 1 },
    "career_stage_other": {
      "type": "string",
      "minLength": 1,
      "description": "Free text, only when career_stage is \"other (please specify)\"."
    },
    "affiliation_type": { "type": "string", "minLength": 1 },
    "languages": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "institution": { "type": "string", "minLength": 1 },
    "ror_id": {
      "type": "string",
      "pattern": "^https://ror\\.org/[0-9a-hj-km-np-tv-z]{9}$"
    },
    "city": { "type": "string", "minLength": 1 },
    "country": { "type": "string", "minLength": 1 },
    "orcid": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[0-9X]$"
    },
    "researchgate_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "scopus_id": { "type": "string", "minLength": 1 },
    "linkedin_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "website_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "es_topics": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "methods": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "methods_other": { "type": "string", "minLength": 1 },
    "ecosystem_focus": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "work_scale": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "sectors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "maxItems": 6,
      "uniqueItems": true
    },
    "current_projects": { "type": "string", "minLength": 1 },
    "project_stage": { "type": "string", "minLength": 1 },
    "study_areas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["region", "ecosystem_type"],
        "properties": {
          "region": { "type": "string", "minLength": 1 },
          "ecosystem_type": { "type": "string", "minLength": 1 },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lon": { "type": "number", "minimum": -180, "maximum": 180 }
        },
        "dependentRequired": { "lat": ["lon"], "lon": ["lat"] }
      }
    },
    "open_to": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "availability_status": { "type": "string", "minLength": 1 },
    "offering_seeking": { "type": "string", "minLength": 1 },
    "preferred_contact": { "type": "string", "minLength": 1 },
    "contact_visibility": { "const": "public" },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "YYYY-MM-DD, set automatically by the form to the export date. The member never types this."
    },
    "consent_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "YYYY-MM-DD, added by JO after written consent is on file."
    },
    "base_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon", "source"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "source": { "enum": ["gazetteer", "ror", "country_centroid"] }
      }
    }
  }
}
